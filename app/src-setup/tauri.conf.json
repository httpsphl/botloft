{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Botloft",
  "identifier": "io.github.httpsphl.botloft.setup",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-setup"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "publisher": "Botloft",
    "copyright": "Copyright 2026 Phelipe Lorran",
    "icon": ["../src-tauri/icons/icon.ico"]
  }
}
