// The daemon's Windows resources (spec 14): its manifest and its version
// information. build.rs fills in the @PLACEHOLDERS@ and compiles the result.
#define RT_MANIFEST 24
1 RT_MANIFEST "@MANIFEST@"

// What Windows shows in the file's properties and in Task Manager, and what a
// code signing service checks against the product it signs (spec 15.5).
1 VERSIONINFO
FILEVERSION @VERSION_NUMBERS@
PRODUCTVERSION @VERSION_NUMBERS@
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "Botloft"
      VALUE "FileDescription", "Botloft background service"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "Copyright 2026 Phelipe Lorran"
      VALUE "InternalName", "botloftd"
      VALUE "OriginalFilename", "botloftd.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
